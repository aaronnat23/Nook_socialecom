{
  "expo": {
    "name": "Nook",
    "slug": "nook",
    "scheme": "nook",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "studio.nook.app"
    },
    "android": {
      "package": "studio.nook.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8F1E4",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "backgroundColor": "#F8F1E4",
    "icon": "./assets/icon.png"
  }
}
