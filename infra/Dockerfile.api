FROM python:3.12-slim
WORKDIR /app
COPY apps/api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY apps/api /app/apps/api
RUN useradd -m -u 10001 lilac && mkdir -p /app/.local/uploads && chown -R lilac:lilac /app
USER lilac
WORKDIR /app/apps/api
# Hosts such as Render and Fly tell the container which port to listen on through $PORT.
CMD ["sh", "-c", "alembic upgrade head && python -m app.seed && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
